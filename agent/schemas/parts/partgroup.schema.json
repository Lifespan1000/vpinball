{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vpz-part-partgroup.schema.json",
  "title": "VPZ partgroup part",
  "description": "A parts/<name>.json document of type \"partgroup\". Generated by agent/tools/gen-part-schemas.mjs from 104 sample part(s) in 8 table(s); do not edit by hand. x-observed-* and examples describe the samples, not hard limits.",
  "type": "object",
  "properties": {
    "$type": {
      "const": "partgroup"
    },
    "center": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "x-observed-range": [
            0,
            0
          ],
          "examples": [
            0
          ]
        },
        "y": {
          "type": "number",
          "x-observed-range": [
            0,
            0
          ],
          "examples": [
            0
          ]
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "dragpoints": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "id": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "legacy_layer": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "name": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "named_layer": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "part_group": {
      "description": "Declared by the serializer but never seen in the samples; type unknown."
    },
    "player_mode_visibility_mask": {
      "type": "integer",
      "x-observed-range": [
        65507,
        65535
      ],
      "x-observed-values": [
        65535,
        65520,
        65511,
        65528,
        65507
      ]
    },
    "space_reference": {
      "type": "integer",
      "x-observed-range": [
        0,
        3
      ],
      "x-observed-values": [
        0,
        2,
        1,
        3
      ]
    },
    "timer_enabled": {
      "type": "boolean",
      "examples": [
        false,
        true
      ]
    },
    "timer_interval": {
      "type": "integer",
      "x-observed-range": [
        100,
        100
      ],
      "x-observed-values": [
        100
      ]
    },
    "ui_locked": {
      "type": "boolean",
      "examples": [
        false
      ]
    },
    "ui_visible": {
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    }
  },
  "required": [
    "$type",
    "center",
    "player_mode_visibility_mask",
    "space_reference",
    "timer_enabled",
    "timer_interval",
    "ui_locked",
    "ui_visible"
  ],
  "additionalProperties": false
}
